# Voyager API configuration. Copy to apps/api/.env. Everything is optional except GROQ_API_KEY
# (without it the deterministic planner answers and every plan says so).

# --- LLM (Groq, free tier) ---------------------------------------------------------------------
GROQ_API_KEY=
# VOYAGER_MODEL_LARGE=openai/gpt-oss-120b      # itinerary + critic judge
# VOYAGER_MODEL_SMALL=openai/gpt-oss-20b       # parallel specialists + /parse
# VOYAGER_MODEL_BACKUP=qwen/qwen3.8-27b        # used when a model's daily quota is spent
# VOYAGER_REASONING_EFFORT=low
# RAGAS_JUDGE_MODEL=qwen/qwen3.8-27b           # offline eval judge (separate free-tier quota)

# --- Langfuse (tracing + scores; off when unset) -----------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=development

# --- Qdrant: embedded on disk (data/qdrant) unless QDRANT_URL is set ----------------------------
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# VOYAGER_INGEST_ON_BOOT=true                  # index data/corpus.jsonl at startup if missing
# VOYAGER_EMBED_THREADS=                       # ONNX threads (empty = all cores)
# FASTEMBED_CACHE_PATH=                        # model cache (default data/models)

# --- persistence -------------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@host/db   # default: SQLite at data/voyager.db
# VOYAGER_PLAN_CACHE_TTL=21600                  # identical request -> cached plan (seconds)

# --- A2A Budget Analyst ------------------------------------------------------------------------
# A2A_BUDGET_URL=http://localhost:9101          # default: the copy mounted at <PUBLIC_BASE_URL>/a2a/budget
# PUBLIC_BASE_URL=http://localhost:8000          # how this API reaches itself (A2A agent card URL)
# VOYAGER_MOUNT_A2A=true

# --- HTTP / limits -----------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
# PORT=8000
# RATE_LIMIT_WRITE_PER_MIN=8
# RATE_LIMIT_READ_PER_MIN=240
# VOYAGER_USER_AGENT="Voyager-TravelPlanner/2.0 (+https://github.com/<you>/<repo>)"   # Wikimedia needs a URL
# MCP_TRANSPORT=inprocess                       # or stdio (spawns the 3 MCP servers as subprocesses)

# --- tests -------------------------------------------------------------------------------------
# VOYAGER_OFFLINE=1                             # fake LLM, mocked tools, no network (CI)
