# Copy these into Streamlit Cloud:  App -> Settings -> Secrets
# Streamlit exposes them as environment variables, which is how config.py
# reads them. Do NOT commit a filled-in version of this file.

GROQ_API_KEY = "gsk_your_key_here"
LLM_MODEL = "openai/gpt-oss-120b"

# The reranker needs sentence-transformers (~400 MB) which is intentionally
# not installed on the free tier. Grounding still works without it - the
# destination filter is what gates unknown destinations.
RERANK_ENABLED = "false"

# Optional - tracing. Omit entirely to run without it.
# LANGFUSE_PUBLIC_KEY = "pk-lf-..."
# LANGFUSE_SECRET_KEY = "sk-lf-..."
# LANGFUSE_HOST_URL = "https://us.cloud.langfuse.com"
